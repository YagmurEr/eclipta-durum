# systemd hizmet tanımı. APP_DIR ve User değerlerini sunucuya göre değiştirin.
[Unit]
Description=Eclipta Durum service monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=eclipta
Group=eclipta
WorkingDirectory=/opt/eclipta-durum
Environment=PYTHONUNBUFFERED=1
Environment=PORT=5000
ExecStart=/opt/eclipta-durum/venv/bin/python app.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/eclipta-durum

[Install]
WantedBy=multi-user.target
